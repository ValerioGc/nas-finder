{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Tool for finding local NAS with Open nas devices in the local network.",
  "windows": ["main"],
  "permissions": [
    "allow-list-saved",
    "allow-discover-nas",
    "allow-save-nas",
    "allow-forget-nas",
    "allow-open-nas",
    "allow-confirm-nas-endpoint",
    "allow-minimize-window",
    "allow-toggle-maximize-window",
    "allow-close-window",
    "allow-start-window-dragging"
  ]
}
